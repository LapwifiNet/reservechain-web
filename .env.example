# ReserveChain web (working draft)

# Canonical origin of THIS deployment, no trailing slash. Read by the canonical
# tag, the hreflang alternates, robots.txt and sitemap.xml. There is no default
# in code on purpose: a wrong canonical tells a crawler the real page lives
# somewhere else, so unset means those tags are simply omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Whether crawlers may index this deployment. Anything other than the exact
# string "true" means robots.txt is `Disallow: /` and every page carries
# `noindex, nofollow`. Set it only on the production deployment: the site
# states on every page that it is in development and that no tokens are offered
# or sold, and a preview deployment that invites indexing publishes that.
# The investor portal stays out of the index even when this is true.
SITE_INDEXABLE=false

# Waitlist registrations are stored by the API, which is the single source of
# truth for them. The website's /api/waitlist route proxies to this base URL.
#
# Server-side only — do NOT rename this to NEXT_PUBLIC_*. It must not reach the
# browser. No credential is sent with the request: POST /waitlist is public by
# design, and the website holds no service token.
#
# Local:  http://127.0.0.1:4000/api
# Docker: http://api:4000/api
# Vercel: set this to the deployed API host, e.g. https://api.example.com/api
WAITLIST_API_BASE=http://127.0.0.1:4000/api

# Mount the OpenAPI schema browser at /api/docs. Must be the exact string
# "true"; anything else (including unset) mounts NO route at all — /api/docs
# 404s exactly as any unhandled path does. Off by default because an
# unauthenticated schema browser on an API carrying KYC case management, an
# audit trail and investor registration enumerates every route, role and field
# name to anyone who can reach the host. The committed api/openapi.json already
# serves both generated clients, so the running server has no reason to serve
# it too. Never enable this on an internet-reachable deployment.
API_DOCS_ENABLED=false

# Website mode: development (default) | prelaunch | waitlist | documentation |
# asset-verification | eligibility | early-participation | live-offering | redemption |
# enterprise-onboarding. Never enables a gated module by itself (FR-MODE, decision D4).
SITE_MODE=development
