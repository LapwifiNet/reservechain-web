# Docker Compose environment for the full ReserveChain stack.
# Copy to .env (gitignored) before running `docker compose up`:
#
#   cp .env.docker.example .env
#
# Generate the three required secrets with:
#   openssl rand -hex 32

# --- Required secrets (>= 32 characters each) --------------------------------
# The API refuses to start if these are missing or too short.
JWT_SECRET=
# Shared between the API and the admin console (admin authenticates with it).
SERVICE_API_TOKEN=
# P8 investor portal. Must differ from JWT_SECRET — investor and admin tokens
# are disjoint domains signed with different keys.
INVESTOR_JWT_SECRET=
# CMS (Payload) session signing key. Must differ from BOTH secrets above — the
# CMS is a third disjoint token domain and refuses to start otherwise.
PAYLOAD_SECRET=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=reservechain
POSTGRES_PASSWORD=reservechain
POSTGRES_DB=reservechain
POSTGRES_PORT=5432

# --- CMS database ------------------------------------------------------------
# A separate Postgres instance. The CMS never shares the API's database.
#
# Check the port is free before starting: 5433 is a common second-Postgres port
# and other local stacks take it.
#   lsof -iTCP:5433 -sTCP:LISTEN -n -P
# If it is taken, change CMS_POSTGRES_PORT here AND the port in cms/.env. A
# DATABASE_URI pointing at the wrong Postgres does not error — it connects, and
# Payload migrates a database that belongs to another project.
CMS_POSTGRES_USER=reservechain
CMS_POSTGRES_PASSWORD=reservechain
CMS_POSTGRES_DB=reservechain_cms
CMS_POSTGRES_PORT=5433

# --- Host ports --------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
ADMIN_PORT=4100
CMS_PORT=3001

# --- API ---------------------------------------------------------------------
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000,http://localhost:4100

# Seed admin/compliance/viewer users on container start (local use only).
RUN_DB_SEED=false
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
SEED_VIEWER_PASSWORD=

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The website proxies waitlist signups to the API, which owns the data. Inside
# the compose network the API is reachable as `api`. Server-side only — never
# rename to NEXT_PUBLIC_*, and no credential is sent (the endpoint is public).
WAITLIST_API_BASE=http://api:4000/api

# The website renders Digital Asset Passports from the CMS's public,
# published-only endpoints. Server-side only, same rule as above — the browser
# never talks to the CMS and no credential is sent.
CMS_API_BASE=http://cms:3001/api

# --- Gated modules -----------------------------------------------------------
# Hard-coded to "false" in docker-compose.yml and not read from here, so a stray
# value in .env cannot open them. Listed for visibility only: the handlers refuse
# regardless of the flag, so enabling one activates nothing.
#   PROOF_OF_RESERVES_ENABLED=false
#   REDEMPTION_ENABLED=false
#   WALLET_ENABLED=false
#   PURCHASE_ENABLED=false
# No private key, mnemonic or seed phrase belongs in this file. Wallet linking
# records a public address only; it never takes custody of the key behind it.

# --- Chain sync (TESTNET ONLY) -----------------------------------------------
# Mainnet chain IDs are blocked in code. Leave disabled unless explicitly needed.
CHAIN_SYNC_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=11155111
TOKEN_ADDRESS=
CHAIN_SYNC_START_BLOCK=0

# Website mode: development (default) | prelaunch | waitlist | documentation |
# asset-verification | eligibility | early-participation | live-offering | redemption |
# enterprise-onboarding. Never enables a gated module by itself (FR-MODE, decision D4).
#
# This is the FALLBACK only. The CMS `settings` row is the source of truth once
# it exists; `npm run seed` does not create it, so on a fresh database the site
# runs on this value. It is passed to the web service by docker-compose.yml — it
# previously was not, which made every value here a no-op.
SITE_MODE=development
