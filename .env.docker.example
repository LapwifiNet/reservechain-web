# Docker Compose environment for the full ReserveChain stack.
# Copy to .env (gitignored) before running `docker compose up`:
#
#   cp .env.docker.example .env
#
# Generate the two required secrets with:
#   openssl rand -hex 32

# --- Required secrets (>= 32 characters each) --------------------------------
# The API refuses to start if these are missing or too short.
JWT_SECRET=
# Shared between the API and the admin console (admin authenticates with it).
SERVICE_API_TOKEN=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=reservechain
POSTGRES_PASSWORD=reservechain
POSTGRES_DB=reservechain
POSTGRES_PORT=5432

# --- Host ports --------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
ADMIN_PORT=4100

# --- API ---------------------------------------------------------------------
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000,http://localhost:4100

# Seed admin/compliance/viewer users on container start (local use only).
RUN_DB_SEED=false
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
SEED_VIEWER_PASSWORD=

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Chain sync (TESTNET ONLY) -----------------------------------------------
# Mainnet chain IDs are blocked in code. Leave disabled unless explicitly needed.
CHAIN_SYNC_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=11155111
TOKEN_ADDRESS=
CHAIN_SYNC_START_BLOCK=0
