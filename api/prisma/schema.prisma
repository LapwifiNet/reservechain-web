generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssetProgram {
  id          String        @id @default(cuid())
  code        String        @unique // e.g. CP (Copper Powder)
  name        String
  metal       String
  purity      String
  description String?
  status      String        @default("active")
  records     AssetRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AssetRecord {
  id        String       @id @default(cuid())
  assetId   String       @unique // e.g. RC-CP-2024-0001
  program   AssetProgram @relation(fields: [programId], references: [id])
  programId String
  batch     String?
  weightKg  Float?
  status    String       @default("registered")
  passports Passport[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Passport {
  id            String      @id @default(cuid())
  passportId    String      @unique // e.g. RC-CP-2024-0001
  assetRecord   AssetRecord @relation(fields: [assetRecordId], references: [id])
  assetRecordId String
  template      String      @default("Illustrative")
  purity        String?
  status        String      @default("draft")
  issuedAt      DateTime?
  createdAt     DateTime    @default(now())
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  fullName     String
  // Unique so a resubmission returns the existing row instead of duplicating.
  email        String   @unique
  investorType String
  consent      Boolean  @default(false)
  // Optional context captured from the public website form.
  organization String?
  interest     String?
  locale       String   @default("en")
  createdAt    DateTime @default(now())
}

model ChainEvent {
  id          String   @id @default(cuid())
  txHash      String
  logIndex    Int
  eventName   String
  blockNumber Int
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
}

model TokenomicsConfig {
  id        String   @id @default(cuid())
  key       String   @unique @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  COMPLIANCE
  VIEWER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KycCase {
  id           String    @id @default(cuid())
  subjectType  String
  legalName    String
  country      String
  status       String    @default("pending")
  riskLevel    String?
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  sequence    Int       @default(autoincrement())
  actorId     String?
  actorEmail  String?
  actorRole   String?
  action      String
  resourceType String?
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  prevHash    String?
  hash        String?
  createdAt   DateTime  @default(now())

  @@index([sequence])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
