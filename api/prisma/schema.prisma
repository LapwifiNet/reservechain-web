generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssetProgram {
  id          String        @id @default(cuid())
  code        String        @unique // e.g. CP (Copper Powder)
  name        String
  metal       String
  purity      String
  description String?
  status      String        @default("active")
  records     AssetRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AssetRecord {
  id        String       @id @default(cuid())
  assetId   String       @unique // e.g. RC-CP-2024-0001
  program   AssetProgram @relation(fields: [programId], references: [id])
  programId String
  batch     String?
  weightKg  Float?
  status    String       @default("registered")
  passports Passport[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Passport {
  id            String      @id @default(cuid())
  passportId    String      @unique // e.g. RC-CP-2024-0001
  assetRecord   AssetRecord @relation(fields: [assetRecordId], references: [id])
  assetRecordId String
  template      String      @default("Illustrative")
  purity        String?
  status        String      @default("draft")
  issuedAt      DateTime?
  createdAt     DateTime    @default(now())
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  fullName     String
  // Unique so a resubmission returns the existing row instead of duplicating.
  email        String   @unique
  investorType String
  consent      Boolean  @default(false)
  // Optional context captured from the public website form.
  organization String?
  interest     String?
  locale       String   @default("en")
  createdAt    DateTime @default(now())
}

model ChainEvent {
  id          String   @id @default(cuid())
  txHash      String
  logIndex    Int
  eventName   String
  blockNumber Int
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
}

model TokenomicsConfig {
  id        String   @id @default(cuid())
  key       String   @unique @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  COMPLIANCE
  VIEWER
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KycCase {
  id          String    @id @default(cuid())
  subjectType String
  legalName   String
  country     String
  // P8: optional link to a portal investor by normalised email. The investor
  // portal's read-only status endpoint surfaces the latest case matching it.
  email       String?
  status      String    @default("pending")
  riskLevel   String?
  // P8: persisted sanctions-screening outcome. Null until a real (non-stub)
  // screening writes it; the portal shows null as "not screened".
  sanctions   String?
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// P8: public investors who self-register on the website portal. Deliberately
// separate from AdminUser (staff) — and from the Role enum feeding @Roles() —
// so an investor account can never satisfy an admin route's role check.
// Portal tokens carry typ="investor" and are signed with INVESTOR_JWT_SECRET.
model InvestorUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditEvent {
  id           String   @id @default(cuid())
  sequence     Int      @default(autoincrement())
  actorId      String?
  actorEmail   String?
  actorRole    String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  prevHash     String?
  hash         String?
  createdAt    DateTime @default(now())

  @@index([sequence])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ---- P11/P12: gated modules (Proof-of-Reserves, Redemption) ----
// These models are published SHAPE, not storage in use. Both modules are
// inactive: their services refuse every call, touch no database, and do not
// import PrismaModule. The tables are created by the por_redemption migration
// and stay empty until the modules are genuinely implemented under written
// authorization. Nothing seeds them, and no fixture data exists for them.

model ReserveAttestation {
  id                String   @id @default(cuid())
  programCode       String
  circulatingSupply Float
  verifiedReserve   Float
  ratio             Float
  method            String
  status            String   @default("draft") // draft | published
  notes             String?
  attestedBy        String?
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime @default(now())

  @@index([status, periodEnd])
}

model RedemptionRequest {
  id                String   @id @default(cuid())
  investorEmail     String
  programCode       String
  amount            Float
  status            String   @default("pending") // pending | approved | rejected | settled
  approvals         Int      @default(0)
  requiredApprovals Int      @default(2)
  rejectionReason   String?
  reviewedBy        String?
  txRef             String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([investorEmail, createdAt])
  @@index([status])
}

// ---- Wallet / Purchase: gated modules, published SHAPE only ----
// Same rule as the P11/P12 models above: both services refuse every call,
// import no PrismaModule, and touch neither table. Created by the
// wallet_purchase migration and must stay empty. A Wallet row is durable,
// publicly correlatable identity data tied to a named investor, and a
// PurchaseIntent is a record of an order for a token that is not issued —
// neither may be populated until the modules are implemented under written
// authorization. No key material is modelled here: an address is a public
// identifier, and nothing in this schema holds a private key, mnemonic or seed.

model Wallet {
  investorEmail String   @id
  address       String
  chainId       Int      @default(11155111) // Sepolia testnet only (AGENTS §1)
  status        String   @default("linked") // linked | revoked
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([address])
}

model PurchaseIntent {
  id              String   @id @default(cuid())
  investorEmail   String
  programCode     String
  tokenAmount     Float
  quoteCurrency   String?
  walletAddress   String
  network         String   @default("testnet")
  status          String   @default("pending") // pending | approved | rejected | settled
  rejectionReason String?
  reviewedBy      String?
  txRef           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([investorEmail, createdAt])
  @@index([status])
}

model Enquiry {
  id        String   @id @default(cuid())
  kind      String // enterprise | asset-owner | industrial-buyer | contact
  fullName  String
  email     String
  // Optional context captured from the public website form.
  company   String?
  message   String
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// ── P17 — Reconciliation (FR-RECON) ─────────────────────────────────────
// A run records one execution of the reconciliation suite. Results are
// never auto-adjusted — exceptions are reported for human resolution.
model ReconcileRun {
  id         String   @id @default(cuid())
  type       String // e.g. chain_gaps | audit_integrity | supply_coverage (registered, unavailable until sources active)
  status     String   @default("completed") // completed | failed
  summary    Json? // counts, verdict per check
  createdBy  String? // admin email when started by a user
  startedAt  DateTime @default(now())
  finishedAt DateTime @updatedAt

  exceptions ReconcileException[]

  @@index([type, startedAt])
}

model ReconcileException {
  id        String   @id @default(cuid())
  runId     String
  run       ReconcileRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  code      String // e.g. chain_gap | duplicate_event | audit_break | coverage_mismatch
  severity  String   @default("warning") // info | warning | critical
  message   String
  data      Json?
  resolved  Boolean  @default(false)
  resolvedBy String?
  resolvedAt DateTime?

  @@index([resolved, code])
  @@index([runId])
}
