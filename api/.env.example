# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
# Use 127.0.0.1 for local host connections and localhost for non-Docker environments.
DATABASE_URL="postgresql://reservechain:reservechain@127.0.0.1:5432/reservechain?schema=public"

# Authentication (P6)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRES_IN=12h
SERVICE_API_TOKEN=change-this-to-a-secure-random-string-min-32-chars

# Investor portal (P8). MUST be set, >= 32 chars, and MUST differ from
# JWT_SECRET — investor and admin tokens are disjoint domains signed with
# different keys, and the API refuses to start otherwise.
INVESTOR_JWT_SECRET=change-this-to-a-different-secure-random-string

# Seed passwords (optional, will generate random if unset)
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
SEED_VIEWER_PASSWORD=

# Chain sync (TESTNET ONLY). Disabled by default.
CHAIN_SYNC_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=11155111            # Sepolia. Mainnet (1) is blocked in code.
TOKEN_ADDRESS=
CHAIN_SYNC_START_BLOCK=0

# Sensitive modules — remain inactive until written authorization (P11/P12).
# These flags gate route reachability only. The handlers behind them refuse
# regardless: AGENTS §2 forbids wiring a gated module to real logic even behind
# a flag that defaults on, so setting either to true changes 501 at the guard
# into 501 at the service, and activates nothing.
PROOF_OF_RESERVES_ENABLED=false
REDEMPTION_ENABLED=false

# Staff approvals required before a redemption could be settled (multisig-style
# threshold). Read by nothing today — the redemption service is inactive — and
# documented here as part of the published shape.
REDEMPTION_REQUIRED_APPROVALS=2

# Wallet linking and token purchase. Same rule as the two flags above: these
# gate route reachability only, and the handlers refuse regardless, so enabling
# either activates nothing. Purchase is testnet-only (Sepolia) even once
# implemented; mainnet requires written authorization (P20, AGENTS §1).
# No private key, mnemonic or seed phrase belongs in this file or anywhere else
# in the repository — linking a wallet never requires custody of its key.
WALLET_ENABLED=false
PURCHASE_ENABLED=false

# Mount the OpenAPI schema browser at /api/docs. Must be the exact string
# "true"; anything else (including unset) mounts NO route at all — /api/docs
# 404s exactly as any unhandled path does. Off by default because an
# unauthenticated schema browser on an API carrying KYC case management, an
# audit trail and investor registration enumerates every route, role and field
# name to anyone who can reach the host. The committed api/openapi.json already
# serves both generated clients, so the running server has no reason to serve
# it too. Never enable this on an internet-reachable deployment.
API_DOCS_ENABLED=false

# Waitlist confirmation email (FR-WL). Both unset = delivery is a logged no-op
# and registrations still succeed. Set both to wire any HTTP-capable mail
# provider (Resend/SendGrid/Postmark/SMTP relay webhook) without code changes.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
