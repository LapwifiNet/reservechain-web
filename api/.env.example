# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
# Use 127.0.0.1 for local host connections and localhost for non-Docker environments.
DATABASE_URL="postgresql://reservechain:reservechain@127.0.0.1:5432/reservechain?schema=public"

# Authentication (P6)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRES_IN=12h
SERVICE_API_TOKEN=change-this-to-a-secure-random-string-min-32-chars

# Investor portal (P8). MUST be set, >= 32 chars, and MUST differ from
# JWT_SECRET — investor and admin tokens are disjoint domains signed with
# different keys, and the API refuses to start otherwise.
INVESTOR_JWT_SECRET=change-this-to-a-different-secure-random-string

# Seed passwords (optional, will generate random if unset)
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
SEED_VIEWER_PASSWORD=

# Chain sync (TESTNET ONLY). Disabled by default.
CHAIN_SYNC_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=11155111            # Sepolia. Mainnet (1) is blocked in code.
TOKEN_ADDRESS=
CHAIN_SYNC_START_BLOCK=0

# Sensitive modules — remain inactive until written authorization (P11/P12).
# These flags gate route reachability only. The handlers behind them refuse
# regardless: AGENTS §2 forbids wiring a gated module to real logic even behind
# a flag that defaults on, so setting either to true changes 501 at the guard
# into 501 at the service, and activates nothing.
PROOF_OF_RESERVES_ENABLED=false
REDEMPTION_ENABLED=false

# Staff approvals required before a redemption could be settled (multisig-style
# threshold). Read by nothing today — the redemption service is inactive — and
# documented here as part of the published shape.
REDEMPTION_REQUIRED_APPROVALS=2
