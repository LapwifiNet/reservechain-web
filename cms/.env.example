# ReserveChain CMS (Payload v2) — uses its OWN database, separate from the
# NestJS API's Prisma database, so Payload-managed tables never collide and the
# CMS cannot read or write API data. This is NOT the API's DATABASE_URL.
#
# REQUIRED — there is no fallback. A wrong host or port does not fail: it
# connects, migrates, and prints "Done" against somebody else's database. Before
# running migrations, confirm the port belongs to THIS project's CMS Postgres:
#
#   lsof -iTCP:5433 -sTCP:LISTEN -n -P     # is 5433 taken by another stack?
#   docker compose ps postgres-cms         # is our container the one on it?
#
# Docker publishes Postgres over TCP only, so psql/dropdb need an explicit host:
#   psql -h localhost -p 5433 -U reservechain -d reservechain_cms
# Without -h they try the unix socket and fail with "No such file or directory",
# which looks like a dead database but is only a dead socket path.
DATABASE_URI=postgresql://reservechain:reservechain@localhost:5433/reservechain_cms?schema=public

# Payload's session signing key. Must be at least 32 characters and MUST differ
# from the API's JWT_SECRET and INVESTOR_JWT_SECRET — the CMS is a third,
# disjoint token domain, and the service refuses to start otherwise.
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-this-to-a-secure-random-string-min-32-chars

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PORT=3001

# Comma-separated origins allowed to call the CMS REST/GraphQL API (the public
# website and the admin console).
CORS_ORIGINS=http://localhost:3000,http://localhost:4100

# Seed admin account (local use only; `npm run seed` skips users in production).
# Leave the password unset and the seed generates a random one and prints it
# once. Never commit a real credential here.
SEED_ADMIN_EMAIL=cms-admin@example.local
SEED_ADMIN_PASSWORD=

# NOTE: `npm run seed` does NOT create the `settings` singleton row. Create it
# once in the admin UI (Settings → Create); until it exists the website falls
# back to the SITE_MODE env value and the first state on each status scale.
# Settings.ts sets `delete: () => false`, so a row created with the wrong
# siteMode cannot be removed through the UI — only `DELETE FROM settings`.
