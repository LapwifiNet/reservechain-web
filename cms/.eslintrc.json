{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    "src/payload-types.ts",
    "src/generated-schema.graphql"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn"
  }
}
