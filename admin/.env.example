# Base URL of the ReserveChain backend (P5). Server-side only (not exposed to the browser).
# Local dev (API on host):        http://127.0.0.1:4000/api
# API in same docker network:     http://api:4000/api
API_BASE_URL=http://127.0.0.1:4000/api

# Service API token for authentication (P6). Must match SERVICE_API_TOKEN in the API backend.
API_TOKEN=change-this-to-match-api-service-token
