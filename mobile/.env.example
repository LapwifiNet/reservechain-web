# Public runtime config.
#
# EXPO_PUBLIC_* variables are INLINED INTO THE SHIPPED BUNDLE at build time and
# are readable by anyone who downloads the app. They are published, not
# configured. Never put a token, API key, signing secret or account identifier
# in one — the two values below are base URLs for endpoints that already serve
# unauthenticated callers, which is the only reason they are safe here.
#
# There is no default. An unset base makes the first request fail with
# `not_configured` rather than silently pointing at a host this project does not
# control.
#
# Local development: a simulator can reach your machine on localhost, but a
# physical device cannot — use your LAN IP for on-device testing.
EXPO_PUBLIC_API_BASE=http://localhost:4000/api
EXPO_PUBLIC_CMS_BASE=http://localhost:3001/api
